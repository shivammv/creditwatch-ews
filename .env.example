# CreditWatch EWS Configuration Example
# Copy to .env and adjust as necessary for deployment

# Server Ports
FASTAPI_PORT=8000
FASTAPI_HOST=127.0.0.1
FRONTEND_PORT=3000

# Operational Risk Policy Parameters
COST_FALSE_NEGATIVE=20.0
COST_FALSE_POSITIVE=1.0
REVIEW_BUDGET_CAP_PCT=5.0

# Paths
MODEL_ARTIFACT_PATH=artifacts/model_production.joblib
INDIAN_DATA_DIR=data/indian
POLISH_DATA_DIR=data/polish
